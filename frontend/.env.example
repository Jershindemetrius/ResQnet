# ResQNet Frontend Environment Variables

# Optional API base URL override. By default, API requests use the same-origin
# Vite proxy to the host backend; LAN clients therefore need only port 5173.
# VITE_API_BASE_URL=http://localhost:8080/api
# LAN example (replace HOST_LAN_IP with the backend host's current Wi-Fi IPv4):
# VITE_API_BASE_URL=http://HOST_LAN_IP:8080/api

# Optional backend target for the host's Vite proxy:
# RESQNET_API_PROXY_TARGET=http://127.0.0.1:8080

# Free default map tiles use OpenStreetMap and require no API key.
# To use another tile provider, replace the URL with its template. Store any
# provider key in this ignored local .env file, not in committed source.
# VITE_MAP_TILE_URL=https://tile-provider.example/{z}/{x}/{y}?key=YOUR_API_KEY
# VITE_MAP_ATTRIBUTION=Map tiles © Your provider

# For production deployment, update to your production API URL:
# VITE_API_BASE_URL=https://your-production-domain.com/api
